# ========================================
# REQUIRED: LLM Configuration
# ========================================

# Google API Key for Gemini API
# Get your key at: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Gemini model to use (default: gemini-1.5-flash)
GOOGLE_MODEL=gemini-1.5-flash

# ========================================
# OPTIONAL: LangSmith Tracing & Monitoring
# ========================================

# Enable LangSmith tracing for observability
# Set to "true" to enable, "false" to disable (default: false)
LANGSMITH_TRACING=false

# LangSmith API Key (required if LANGSMITH_TRACING=true)
# Get your key at: https://smith.langchain.com/
LANGSMITH_API_KEY=your_langsmith_api_key_here

# LangSmith project name (default: SecureOps-SOC-Assistant)
LANGSMITH_PROJECT=SecureOps-SOC-Assistant

# LangSmith API endpoint
# For US: https://api.smith.langchain.com (default)
# For EU: https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ========================================
# OPTIONAL: Debug & Logging
# ========================================

# Enable debug logging (default: false)
DEBUG=false
